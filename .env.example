# Database
#   DATABASE_URL=postgresql://user:password@host.neon.tech/promptdebt?sslmode=require
DATABASE_URL=

# GitHub fine grained personal access token
GITHUB_TOKEN=

# origins allowed to call api (for capacitor build)
CORS_ORIGINS=capacitor://localhost,http://localhost

# Optional AI review (conflicting rules + summary):
#   LLM_BASE_URL=https://api.groq.com/openai/v1
#   LLM_MODEL=openai/gpt-oss-120b
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=

# Set to 1 when running behind a reverse proxy
TRUST_PROXY=0
